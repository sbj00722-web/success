# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, = 뒤에 키를 붙여넣으세요.
# .env 는 GitHub 에 올라가지 않아요.

# Claude: NG 컷, 설명 그림 위치 정하기, 개인정보 판단. 없으면 이 단계들은 건너뜁니다.
ANTHROPIC_API_KEY=

# 설명 그림 생성(OpenAI gpt-image-2). 없으면 Claude 가 SVG 로 직접 그립니다.
OPENAI_API_KEY=

# —— 선택 설정 (기본값 표시) ——————————————————————————————————
# 바꾸고 싶은 줄만 맨 앞 # 을 지우고 값을 고치세요.

# WHISPER_MODEL=large-v3          # 느리면 medium / small
# WHISPER_DEVICE=auto             # auto | cuda | cpu
# LANGUAGE=auto                   # auto: 말소리마다 언어를 알아냄 (한국어+영어 섞인 영상) | ko | en ...
# LANGUAGES=ko,en                 # auto 일 때 고를 언어 (다른 언어가 나오면 추가, 예: ko,en,ja)

# BURN_SUBTITLES=true             # 영상에 자막 직접 넣기 (false 면 srt 파일만)
# SUBTITLE_POLISH=true            # AI 로 자막 오타 고치기 + 외국어 한국어 번역 (Claude → OpenAI 순)
# OPENAI_TEXT_MODEL=gpt-5.5       # Claude 를 못 쓸 때 자막 다듬기에 쓸 OpenAI 모델
# LOCAL_TRANSLATE=true            # AI 를 못 쓸 때 PC 안의 번역 모델로 번역 (처음 한 번 약 5GB 다운로드)
# LOCAL_TRANSLATE_MODEL=facebook/nllb-200-distilled-1.3B
# SUBTITLE_SHOW_ORIGINAL=true     # 외국어 자막에 원래 말도 작게 같이
# SUBTITLE_MAX_CHARS=28           # 한국어 자막 한 덩어리 최대 글자 수
# SUBTITLE_SIZE=0.05              # 글자 크기 (화면 짧은 변 대비)
# SUBTITLE_BOTTOM=0.07            # 화면 아래에서 띄우는 거리
# SUBTITLE_FONT=malgunbd.ttf

# CUT_SILENCE=true
# SILENCE_DB=-38                  # 무음 판정 기준(dB), 낮을수록 덜 자름
# MIN_SILENCE=0.6                 # 이 길이(초) 이상 무음만 편집
# KEEP_SILENCE=0.3                # 긴 무음을 이 길이로 줄임
# CUT_FILLERS=true                # "어", "음" 자르기
# FILLER_WORDS=어,어어,음,음음,으음,으,엄,흠,에,에에,어음,음어,um,umm,uh,uhh,uhm,erm
# CUT_RETAKES=true                # 말 더듬기·다시 말하기(NG) 자르기

# ILLUSTRATIONS=true
# ILLUSTRATION_MODE=full          # full(전체 화면 전환) | pip(오른쪽 위 카드)
# MAX_ILLUSTRATIONS=6             # 영상 하나에 넣을 최대 장수
# ILLUSTRATION_REVIEW=true        # 그린 뒤 Claude 가 한 번 더 검토
# IMAGE_ENGINE=auto               # auto | openai | claude
# IMAGE_MODEL=gpt-image-2
# IMAGE_QUALITY=medium            # low | medium | high
# FONT_FAMILY=Malgun Gothic
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high              # low | medium | high

# PII_SCREEN=true                 # 화면 속 개인정보 모자이크
# OCR_EVERY=1.0                   # 몇 초마다 화면 검사 (짧을수록 정확, 느림)
# OCR_WIDTH=960                   # 클수록 작은 글자도 읽지만 느림
# PII_LLM_CHECK=true              # 정규식 외에 Claude 가 한 번 더 판단
# BLUR_FACES=false                # 얼굴 모자이크 (본인 얼굴도 가려지므로 기본 OFF)
# PII_AUDIO=true                  # 말로 나온 개인정보 삐- 처리

# VIDEO_CODEC=auto                # auto | h264_nvenc | libx264
# VIDEO_QUALITY=20                # 낮을수록 고화질 (파일 커짐)
# VIDEO_PRESET=medium             # libx264 속도
# —— watch.bat 폴더 (기본: 구글 드라이브 '내 드라이브/claude_success') ——
# GDRIVE_DIR=G:\내 드라이브      # 구글 드라이브를 못 찾을 때만 위치 적기
# IN_DIR=G:\내 드라이브\claude_success   # 영상 넣는 폴더를 직접 정하기
# OUT_DIR=G:\내 드라이브\claude_success\output   # 결과물 폴더 (run.bat·명령줄 기본은 autocut\output)
